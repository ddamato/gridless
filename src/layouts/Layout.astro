---
const TITLE = 'gridless.design';
const DESCRIPTION = 'get rid of the grid!';
const URL = 'https://gridless.design';
const FONT_PRELOAD = 'https://fonts.googleapis.com/css2?family=Lora&family=Poppins:wght@300;700&display=swap';

const { frontmatter } = Astro.props;
const title = frontmatter?.title ?? TITLE;
const description = frontmatter?.description ?? DESCRIPTION;

const jsonLd = {
  '@context': 'schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: URL,
};
---
<!doctype html>
<html lang="en">
  <head>
    <title>{title}</title>
    <meta property="og:url" content={URL} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${URL}/og-image.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="twitter:creator" content="@donniedamato" />
    <meta property="twitter:creator:id" content="230538553" />
    <meta http-equiv="content-type" content="text/html; charset=utf-8" />
    <meta http-equiv="X-UA-Compatible" content="chrome=1" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#5bbad5" />
    <meta name="msapplication-TileColor" content="#ffc40d" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="alternate" href={URL} hreflang="en-us" />

    <link href={FONT_PRELOAD} rel="stylesheet" media="all" />
    <link href="/styles.css" rel="stylesheet" media="all" />

    <script is:inline defer>
      window.onload = () =>
        'serviceWorker' in navigator &&
        navigator.serviceWorker
          .register('/sw.js')
          .then((registration) => registration.update())
          .catch(() => {});
    </script>

    <link rel="preconnect" href="https://www.google-analytics.com" crossorigin />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-YYJRNNB39F"></script>
    <script is:inline define:vars={{ siteUrl: URL }}>
      if (window.location.hostname === new URL(siteUrl).hostname) {
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', 'G-YYJRNNB39F', { transport_type: 'beacon' });
      }
    </script>

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <header>
      <a href="/">
        <h1>
          <svg viewBox="0 0 512 512" style="width: 1em; height: 1em">
            <path fill="currentcolor" d="M464.453,395V63.547a16,16,0,0,0-16-16H117l32,32h26.847v26.847l32,32V79.547h96.3v96.3H245.3l32,32h26.847V234.7l32,32V207.849h96.3v96.3H373.606l32,32h26.847V363Zm-128.3-219.149v-96.3h96.3v96.3Z"></path>
            <path fill="currentcolor" d="M16,16.667V39.294L47.547,70.841V448.453a16,16,0,0,0,16,16H441.159l32.214,32.214H496V474.04L38.626,16.667ZM336.151,359.445l73.008,73.008H336.151Zm-128.3-128.3,73.008,73.008H207.849Zm0,105.008h96.3v96.3h-96.3Zm-128.3-233.31,73.008,73.008H79.547Zm0,105.008h96.3v96.3h-96.3Zm0,128.3h96.3v96.3h-96.3Z"></path>
          </svg>
          gridless.design
        </h1>
      </a>
      <ul>
        <li><a href="/history">history</a></li>
        <li><a href="/for-designers">designers</a></li>
        <li><a href="/for-developers">developers</a></li>
        <li><a href="/about">about</a></li>
      </ul>
    </header>
    <main id="top">
      <slot />
    </main>
    <a id="back-to-top" href="#top">Back to top</a>
    <script is:inline async defer src="https://scripts.withcabin.com/hello.js"></script>
    <script is:inline>
      const header = document.querySelector('header');
      const topButton = document.querySelector('#back-to-top');
      let pos = 0;
      window.addEventListener('scroll', () => {
        header.classList.toggle('hide-header', pos < Math.max(window.scrollY, 0));
        topButton.classList.toggle('visible', window.scrollY > 400);
        pos = Math.max(window.scrollY, 0);
      });
    </script>
    <script>
      import '../examples/register.ts';
    </script>
  </body>
</html>
